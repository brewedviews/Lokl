**/.next
**/dist
**/build
**/.git
**/.github
**/.gitignore
**/.env
**/.env.*
!**/.env.example
**/__pycache__
**/.pytest_cache
**/.venv
**/venv
**/.coverage
**/coverage
**/htmlcov
**/.DS_Store
**/.idea
**/.vscode
**/test_reports
**/memory
**/.emergent
**/uploads
**/*.db
**/*.sqlite
README.md
*.log
