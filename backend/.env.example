# NOT a complete environment template — backend/.env has many more vars
# (Mongo, JWT, Razorpay, Cloudinary, Twilio, etc.) not enumerated here yet.
# This file documents newly-added vars as they're introduced; start here
# and merge with whatever your existing backend/.env already has.

# Field-level encryption at rest (services/encryption_service.py).
# Used by MerchantIntegration.api_token (VasyERP) today; the plaintext
# bank-details fields are a planned follow-up consumer.
#
# Generate a real value with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Losing this key makes every already-encrypted value permanently
# unrecoverable — back it up the same way you would JWT_SECRET.
FIELD_ENCRYPTION_KEY=

# VasyERP integration (backend/services/vasyerp_client.py). Request/
# response contract (auth header, envelope shape, pagination) is confirmed
# — the base URL is NOT: it isn't in VasyERP's public docs and has to come
# directly from Ujjwal's VasyERP account/dashboard or their support team.
# Do not guess or hardcode a real-looking host here. Point this at a local
# mock server for dev/testing until the real value is obtained.
VASYERP_API_BASE_URL=

# Shopify integration (backend/services/shopify_client.py). Unlike VasyERP,
# Shopify's base URL is well-known per shop (https://{shop}.myshopify.com —
# derived automatically from the shop_domain the merchant enters at connect
# time, no config needed for a real store). SHOPIFY_API_VERSION defaults to
# 2024-10 if unset. SHOPIFY_API_BASE_URL_OVERRIDE is a TESTING-ONLY escape
# hatch — set it to point every shop_domain at one local mock server
# instead of a real *.myshopify.com host; leave unset in every real
# deployment. No real Shopify store/app credentials exist yet either way —
# see the integration plan doc's testing caveat.
SHOPIFY_API_VERSION=2024-10
SHOPIFY_API_BASE_URL_OVERRIDE=

# Where Shopify should POST inventory_levels/update webhooks (bidirectional
# inventory sync — see server.py's /webhooks/shopify/inventory and
# shopify_client's module docstring). On Railway this is unnecessary —
# RAILWAY_PUBLIC_DOMAIN is already set automatically and used as the
# fallback. Set this explicitly only for a non-Railway deploy target.
# Leave unset in local dev: there's no public URL for Shopify to reach, so
# webhook registration is skipped (not an error) and only the outbound
# half of sync (Lokl order -> Shopify) still works, gated on location_id
# having been fetched successfully at connect time.
BACKEND_PUBLIC_URL=

# MSG91 WhatsApp (backend/notifications.py's MSG91Provider). Only relevant
# when NOTIFICATION_PROVIDER=msg91.
#   MSG91_WHATSAPP_INTEGRATED_NUMBER — the WhatsApp Business number
#     integrated into this MSG91 account, from the MSG91 dashboard.
#   MSG91_WHATSAPP_NAMESPACE — a single UUID-shaped value scoped to the
#     WHOLE WABA account (not per-template — every template shares one
#     namespace), needed only for send_authentication_otp()'s
#     Authentication-category template sends. From the MSG91 dashboard or
#     Meta Business Manager.
#   MSG91_WA_TEMPLATE_CUSTOMER_OTP / _MERCHANT_LOGIN_OTP / _RIDER_LOGIN_OTP
#     — the real APPROVED WhatsApp Authentication template NAME (not a
#     numeric id — WhatsApp templates are identified by name+language) for
#     each login-OTP flow, from the MSG91 dashboard. If a given one is
#     unset, that flow falls back to the plain Lokl-worded
#     send_with_fallback() path instead of the Authentication template —
#     see _deliver_login_otp() in notifications.py.
# NOTE: Meta restricts Authentication-category templates to WhatsApp
# Business accounts meeting a minimum daily conversation-volume threshold
# — confirm eligibility in the MSG91/Meta dashboard before assuming this
# path is usable regardless of code correctness.
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WA_TEMPLATE_CUSTOMER_OTP=
MSG91_WA_TEMPLATE_MERCHANT_LOGIN_OTP=
MSG91_WA_TEMPLATE_RIDER_LOGIN_OTP=

# Gupshup WhatsApp (backend/notifications.py's GupshupProvider). Only
# relevant when NOTIFICATION_PROVIDER=gupshup. Added narrowly to unblock
# login OTP delivery (customer/merchant/rider) — WhatsApp-template-only,
# no SMS/provider-owned-OTP support in this pass. Do NOT set
# NOTIFICATION_PROVIDER=gupshup in production until a real live send has
# been verified (same rule as every other provider cutover).
#   GUPSHUP_API_KEY — from the Gupshup dashboard.
#   GUPSHUP_WHATSAPP_NUMBER — the `source` field: this account's
#     configured/approved WhatsApp Business sending number.
#   GUPSHUP_APP_NAME — the `src.name` field: the Gupshup app name this
#     account's templates are registered under.
#   GUPSHUP_TEMPLATE_CUSTOMER_OTP / _MERCHANT_LOGIN_OTP / _RIDER_LOGIN_OTP
#     — the approved template id (not name) for each login-OTP flow, from
#     the Gupshup dashboard. If a given one is unset while Gupshup is
#     active, that flow fails loudly (logged) rather than silently
#     falling back to a different channel — see _deliver_login_otp() in
#     notifications.py.
GUPSHUP_API_KEY=
GUPSHUP_WHATSAPP_NUMBER=
GUPSHUP_APP_NAME=
GUPSHUP_TEMPLATE_CUSTOMER_OTP=
GUPSHUP_TEMPLATE_MERCHANT_LOGIN_OTP=
GUPSHUP_TEMPLATE_RIDER_LOGIN_OTP=

# WhatsApp merchant product-addition webhook (routes/whatsapp.py). Gupshup's
# own docs describe NO signature/HMAC verification scheme for inbound
# webhooks — this is a plain shared secret sent as a custom header,
# configured on the Gupshup app's Webhooks screen (Integration > Webhooks)
# as a custom header named X-Lokl-Webhook-Secret with this exact value.
# Confirmed live during the technical proof-of-concept (2026-08-29) — every
# genuine Gupshup request carried this header once configured. Rotate by
# changing it in BOTH the Gupshup dashboard and here together.
GUPSHUP_WEBHOOK_SECRET=
