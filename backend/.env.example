# NOT a complete environment template — backend/.env has many more vars
# (Mongo, JWT, Razorpay, Cloudinary, Twilio, etc.) not enumerated here yet.
# This file documents newly-added vars as they're introduced; start here
# and merge with whatever your existing backend/.env already has.

# Field-level encryption at rest (services/encryption_service.py).
# Used by MerchantIntegration.api_token (VasyERP) today; the plaintext
# bank-details fields are a planned follow-up consumer.
#
# Generate a real value with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Losing this key makes every already-encrypted value permanently
# unrecoverable — back it up the same way you would JWT_SECRET.
FIELD_ENCRYPTION_KEY=

# VasyERP integration (backend/services/vasyerp_client.py). Request/
# response contract (auth header, envelope shape, pagination) is confirmed
# — the base URL is NOT: it isn't in VasyERP's public docs and has to come
# directly from Ujjwal's VasyERP account/dashboard or their support team.
# Do not guess or hardcode a real-looking host here. Point this at a local
# mock server for dev/testing until the real value is obtained.
VASYERP_API_BASE_URL=

# Shopify integration (backend/services/shopify_client.py). Unlike VasyERP,
# Shopify's base URL is well-known per shop (https://{shop}.myshopify.com —
# derived automatically from the shop_domain the merchant enters at connect
# time, no config needed for a real store). SHOPIFY_API_VERSION defaults to
# 2024-10 if unset. SHOPIFY_API_BASE_URL_OVERRIDE is a TESTING-ONLY escape
# hatch — set it to point every shop_domain at one local mock server
# instead of a real *.myshopify.com host; leave unset in every real
# deployment. No real Shopify store/app credentials exist yet either way —
# see the integration plan doc's testing caveat.
SHOPIFY_API_VERSION=2024-10
SHOPIFY_API_BASE_URL_OVERRIDE=

# Where Shopify should POST inventory_levels/update webhooks (bidirectional
# inventory sync — see server.py's /webhooks/shopify/inventory and
# shopify_client's module docstring). On Railway this is unnecessary —
# RAILWAY_PUBLIC_DOMAIN is already set automatically and used as the
# fallback. Set this explicitly only for a non-Railway deploy target.
# Leave unset in local dev: there's no public URL for Shopify to reach, so
# webhook registration is skipped (not an error) and only the outbound
# half of sync (Lokl order -> Shopify) still works, gated on location_id
# having been fetched successfully at connect time.
BACKEND_PUBLIC_URL=
