# NOT a complete environment template — backend/.env has many more vars
# (Mongo, JWT, Razorpay, Cloudinary, Twilio, etc.) not enumerated here yet.
# This file documents newly-added vars as they're introduced; start here
# and merge with whatever your existing backend/.env already has.

# Field-level encryption at rest (services/encryption_service.py).
# Used by MerchantIntegration.api_token (VasyERP) today; the plaintext
# bank-details fields are a planned follow-up consumer.
#
# Generate a real value with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Losing this key makes every already-encrypted value permanently
# unrecoverable — back it up the same way you would JWT_SECRET.
FIELD_ENCRYPTION_KEY=

# VasyERP integration (backend/services/vasyerp_client.py). Request/
# response contract (auth header, envelope shape, pagination) is confirmed
# — the base URL is NOT: it isn't in VasyERP's public docs and has to come
# directly from Ujjwal's VasyERP account/dashboard or their support team.
# Do not guess or hardcode a real-looking host here. Point this at a local
# mock server for dev/testing until the real value is obtained.
VASYERP_API_BASE_URL=

# Shopify integration (backend/services/shopify_client.py). Unlike VasyERP,
# Shopify's base URL is well-known per shop (https://{shop}.myshopify.com —
# derived automatically from the shop_domain the merchant enters at connect
# time, no config needed for a real store). SHOPIFY_API_VERSION defaults to
# 2024-10 if unset. SHOPIFY_API_BASE_URL_OVERRIDE is a TESTING-ONLY escape
# hatch — set it to point every shop_domain at one local mock server
# instead of a real *.myshopify.com host; leave unset in every real
# deployment. No real Shopify store/app credentials exist yet either way —
# see the integration plan doc's testing caveat.
SHOPIFY_API_VERSION=2024-10
SHOPIFY_API_BASE_URL_OVERRIDE=

# Where Shopify should POST inventory_levels/update webhooks (bidirectional
# inventory sync — see server.py's /webhooks/shopify/inventory and
# shopify_client's module docstring). On Railway this is unnecessary —
# RAILWAY_PUBLIC_DOMAIN is already set automatically and used as the
# fallback. Set this explicitly only for a non-Railway deploy target.
# Leave unset in local dev: there's no public URL for Shopify to reach, so
# webhook registration is skipped (not an error) and only the outbound
# half of sync (Lokl order -> Shopify) still works, gated on location_id
# having been fetched successfully at connect time.
BACKEND_PUBLIC_URL=

# MSG91 WhatsApp (backend/notifications.py's MSG91Provider). Only relevant
# when NOTIFICATION_PROVIDER=msg91.
#   MSG91_WHATSAPP_INTEGRATED_NUMBER — the WhatsApp Business number
#     integrated into this MSG91 account, from the MSG91 dashboard.
#   MSG91_WHATSAPP_NAMESPACE — a single UUID-shaped value scoped to the
#     WHOLE WABA account (not per-template — every template shares one
#     namespace), needed only for send_authentication_otp()'s
#     Authentication-category template sends. From the MSG91 dashboard or
#     Meta Business Manager.
#   MSG91_WA_TEMPLATE_CUSTOMER_OTP / _MERCHANT_LOGIN_OTP / _RIDER_LOGIN_OTP
#     — the real APPROVED WhatsApp Authentication template NAME (not a
#     numeric id — WhatsApp templates are identified by name+language) for
#     each login-OTP flow, from the MSG91 dashboard. If a given one is
#     unset, that flow falls back to the plain Lokl-worded
#     send_with_fallback() path instead of the Authentication template —
#     see _deliver_login_otp() in notifications.py.
# NOTE: Meta restricts Authentication-category templates to WhatsApp
# Business accounts meeting a minimum daily conversation-volume threshold
# — confirm eligibility in the MSG91/Meta dashboard before assuming this
# path is usable regardless of code correctness.
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WA_TEMPLATE_CUSTOMER_OTP=
MSG91_WA_TEMPLATE_MERCHANT_LOGIN_OTP=
MSG91_WA_TEMPLATE_RIDER_LOGIN_OTP=

# Gupshup WhatsApp (backend/notifications.py's GupshupProvider). Only
# relevant when NOTIFICATION_PROVIDER=gupshup. Do NOT set
# NOTIFICATION_PROVIDER=gupshup in production until a real live send has
# been verified (same rule as every other provider cutover).
#   GUPSHUP_API_KEY — from the Gupshup dashboard.
#   GUPSHUP_WHATSAPP_NUMBER — the `source` field: this account's
#     configured/approved WhatsApp Business sending number.
#   GUPSHUP_APP_NAME — the `src.name` field: the Gupshup app name this
#     account's templates are registered under.
#   GUPSHUP_TEMPLATE_CUSTOMER_OTP — the approved Authentication template
#     id for customer login/signup OTP. Also used for MERCHANT login OTP
#     (2026-09 reconciliation: customer_otp is the one shared OTP
#     template for both — do NOT reintroduce a separate
#     GUPSHUP_TEMPLATE_MERCHANT_LOGIN_OTP var; GupshupProvider._TEMPLATE_ENV
#     in notifications.py points "merchant_login_otp" at this same var).
#   GUPSHUP_TEMPLATE_RIDER_LOGIN_OTP — rider login stays on its own
#     separate template.
#   GUPSHUP_TEMPLATE_ORDER_PLACED / _ORDER_ON_THE_WAY / _ORDER_CANCELLED /
#   _ORDER_REJECTED / _ORDER_DELIVERED / _MERCHANT_NEW_ORDER / _RIDER_PICKUP /
#   _RIDER_RETURN_PICKUP / _MERCHANT_ORDER_CANCELLED / _MERCHANT_APPROVED /
#   _CUSTOMER_RETURN_STATUS / _PAYMENT_FAILED / _MERCHANT_KYC_REJECTED /
#   _MERCHANT_KYC_ON_HOLD —
#     approved Utility/Service-update template ids wired 2026-09. See
#     GupshupProvider._TEMPLATE_ENV in notifications.py for exactly which
#     message_type each maps to, and each notify_* function's own
#     docstring for exactly which variables (in order) it sends — several
#     had variables removed by Meta during approval and are NOT the same
#     shape as the pre-reconciliation freeform message.
#   order_placed specifically: confirmed live to have exactly 4 variables
#     — short order id, total, tracking URL, support phone — all real,
#     none dropped by Meta. Different from most of the others above,
#     which had a URL/extra variable removed during approval.
#   order_on_the_way specifically: confirmed live to have exactly ONE
#     variable (order short id) — no delivery OTP, no rider phone, no
#     tracking URL. The freeform body (used by Twilio/MSG91, or Gupshup
#     if this var is unset) still carries all of those; only the Gupshup
#     template send is restricted to the single confirmed variable. The
#     delivery OTP generation/verification mechanism itself is unaffected
#     either way — see notify_order_on_the_way()'s own docstring.
#   order_cancelled specifically: confirmed live to have exactly 3
#     variables — short order id, a fixed refund-status text ("Since you
#     pay at delivery, no amount was charged." — neither of its 2 call
#     sites currently computes a real paid/refund branch), support phone.
#     The optional cancellation `reason` and the browse-URL are freeform-
#     body-only, not Gupshup variables.
#   merchant_order_cancelled specifically: confirmed live to have exactly
#     ONE variable (short order id) — no reason, customer name/phone,
#     order total, or tracking URL. Replaces the old inline
#     "merchant_order_cancelled_by_customer" ad-hoc sends (which used the
#     FULL order id, not the short-id convention) — see
#     notify_merchant_order_cancelled() in notifications.py.
#   rider_pickup specifically: confirmed live to have exactly 8 variables
#     — order id, store name/address, customer name/address, items, and
#     TWO Google Maps URLs (store + customer). No OTP, rider phone,
#     customer phone, order total, or tracking URL. Recipient is the
#     shared RIDER_PHONE ops number, unaffected by this wiring. KNOWN GAP:
#     the customer map URL variable will be empty for most/all real
#     orders today — delivery addresses have no lat/lng populated in
#     practice (see notify_rider_pickup()'s own docstring); this was not
#     fixed here (no new geocoding service was added, per instruction).
#   rider_return_pickup specifically: confirmed live to have exactly 8
#     variables — the ORIGINAL order's short id (NOT the return id),
#     customer name/address, customer map URL, store name/address, store
#     map URL, returned items. No return id, OTP, or reason — none are
#     variables in the approved template (they remain freeform-body-only,
#     Twilio/MSG91). Same shared RIDER_PHONE recipient and same customer-
#     map-URL data gap as rider_pickup above.
#   If a given one is unset while Gupshup is active, that flow fails
#     loudly (logged) rather than silently falling back to a different
#     channel — see _deliver_login_otp() / send_with_fallback() in
#     notifications.py.
#   GUPSHUP_TEMPLATE_MERCHANT_LAUNCH_NUDGE — one-off Marketing-category
#     campaign template (2026-09), id cebe40ee-c726-402f-849e-872c8b974fa1,
#     sent only via backend/scripts/send_merchant_launch_nudge.py to an
#     explicit admin-supplied merchant list. Exactly 3 variables: merchant/
#     owner name, the fixed site URL, support phone — see
#     notify_merchant_launch_nudge() in notifications.py. Must be set to
#     the approved template id before that script can send for real
#     (--send fails loudly, per-merchant, if this is unset).
GUPSHUP_API_KEY=
GUPSHUP_WHATSAPP_NUMBER=
GUPSHUP_APP_NAME=
GUPSHUP_TEMPLATE_CUSTOMER_OTP=
GUPSHUP_TEMPLATE_RIDER_LOGIN_OTP=
GUPSHUP_TEMPLATE_ORDER_PLACED=
GUPSHUP_TEMPLATE_ORDER_ON_THE_WAY=
GUPSHUP_TEMPLATE_ORDER_CANCELLED=
GUPSHUP_TEMPLATE_MERCHANT_ORDER_CANCELLED=
GUPSHUP_TEMPLATE_ORDER_REJECTED=
GUPSHUP_TEMPLATE_ORDER_DELIVERED=
GUPSHUP_TEMPLATE_MERCHANT_NEW_ORDER=
GUPSHUP_TEMPLATE_RIDER_PICKUP=
GUPSHUP_TEMPLATE_RIDER_RETURN_PICKUP=
GUPSHUP_TEMPLATE_MERCHANT_APPROVED=
GUPSHUP_TEMPLATE_CUSTOMER_RETURN_STATUS=
GUPSHUP_TEMPLATE_PAYMENT_FAILED=
GUPSHUP_TEMPLATE_MERCHANT_KYC_REJECTED=
GUPSHUP_TEMPLATE_MERCHANT_KYC_ON_HOLD=
GUPSHUP_TEMPLATE_MERCHANT_LAUNCH_NUDGE=

# WhatsApp merchant product-addition webhook (routes/whatsapp.py). Gupshup's
# own docs describe NO signature/HMAC verification scheme for inbound
# webhooks — this is a plain shared secret sent as a custom header,
# configured on the Gupshup app's Webhooks screen (Integration > Webhooks)
# as a custom header named X-Lokl-Webhook-Secret with this exact value.
# Confirmed live during the technical proof-of-concept (2026-08-29) — every
# genuine Gupshup request carried this header once configured. Rotate by
# changing it in BOTH the Gupshup dashboard and here together.
GUPSHUP_WEBHOOK_SECRET=

# AI-assisted WhatsApp product extraction (services/whatsapp_ai.py) — an
# ASSISTIVE FALLBACK only, called when deterministic parsing genuinely can't
# resolve a merchant's message (messy/unstructured text, or taxonomy
# classification with no explicit category given). Never called for
# clean structured input, images, YES/CANCEL/RESTART, or duplicate
# messages. Never sent product images — text only, no vision model.
# OPENAI_API_KEY — official OpenAI API key. Already configured in
#   production; leave blank locally unless testing this feature.
# OPENAI_WHATSAPP_MODEL — defaults to "gpt-4o-mini" (an economical model;
#   this feature does not need frontier-model reasoning or vision).
OPENAI_API_KEY=
OPENAI_WHATSAPP_MODEL=

# Social content agent (routes/social_content.py, services/social_agent_service.py)
# — the Lokl x Claude social-agent blueprint's MVP: read-only opportunity
# detection over existing product/store data + a human-approval content
# queue. No new database, no new external notification tool — everything
# runs against this same Mongo database and the existing WhatsApp layer.
#
#   SOCIAL_AGENT_ADMIN_PHONE — plain 10-digit phone (same normalization as
#     every other phone field in this codebase) that receives the WhatsApp
#     "content ready to review" ping via send_with_fallback(). If unset,
#     queue items are still created — the ping is just skipped, so this is
#     safe to leave blank in dev/local.
#   ADMIN_APP_URL — public URL of the admin Next.js app (e.g.
#     https://admin.shoplokl.in), used only to build the "Review: <link>"
#     line in that WhatsApp message. If unset, the message is sent without
#     a link.
SOCIAL_AGENT_ADMIN_PHONE=
ADMIN_APP_URL=

# Store Pickup / Reserve & Collect feature flag (2026-09 product decision).
# The feature (browse online -> reserve -> visit store -> try/buy in
# person, no rider) stays fully implemented in the codebase for future
# activation, but is intentionally NOT offered in production right now.
# Defaults to DISABLED — missing/unset behaves exactly like "false", so a
# forgotten env var can never silently re-enable it. Sits ABOVE the
# existing Pro-plan/store-availability eligibility logic in server.py
# (_attach_store_avail, get_store, the PDP's store_can_pickup, and
# create_order()'s own server-side pickup pre-check) — every one of those
# still requires plan=="pro" AND this flag once set to true; this flag
# does not replace that check. Completely independent of Try & Buy, which
# never reads this flag (it uses order_type=="delivery" with a per-item
# fulfillment_type, never order_type=="pickup").
STORE_PICKUP_ENABLED=false

# 2026-09 product decision — Pay at Delivery is the ONLY payment option for
# new orders while Lokl reduces payment/refund/escalation complexity at
# launch. Defaults to DISABLED, same "missing/unset behaves like false"
# posture as STORE_PICKUP_ENABLED above. Gates razorpay_create_payment_order
# (POST /payments/razorpay/create-order) and create_order's razorpay/online
# payment-method branch — Razorpay integration code, webhooks, and refund
# logic are untouched by this flag, so re-enabling online payment later is a
# pure env-var flip. Historical online-paid orders are unaffected either way.
PAY_ONLINE_ENABLED=false
